# scripts/init_env.py가 안전한 무작위 값을 채운 .env를 생성합니다.
# APP_SECRET: HMAC 서명에 사용하는 서버 전용 비밀키
APP_SECRET=GENERATE_ME
# MySQL 초기 DB/일반 사용자 설정
MYSQL_DATABASE=avalon
MYSQL_USER=avalon
MYSQL_PASSWORD=GENERATE_ME
MYSQL_ROOT_PASSWORD=GENERATE_ME
# 브라우저에서 접속할 호스트 포트
WEB_PORT=8080
# HTTP 쓰기/WebSocket을 허용할 정확한 웹 Origin 목록
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# HTTPS로 운영할 때는 true로 변경
COOKIE_SECURE=false
